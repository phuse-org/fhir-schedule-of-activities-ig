* kind = #ServiceRequest
* intent = #plan
* code
  * text = "Urinalysis Panel" // TODO: add activity code
* observationResultRequirement[+] = Canonical(usdm-obs-uninalysis-lab-panel)

// ObservationDefinition panel: thyroid
Instance: usdm-obs-thyroid-lab-panel
InstanceOf: ObservationDefinition
Usage: #definition
Title: "Thyroid Function Test (Visit 1 only)"
Description: "Lab-derived panel observation definition for thyroid"
* status = #active
* code
  * text = "Thyroid Function Test (Visit 1 only)" // TODO: add LOINC panel code
* hasMember[+] = Reference(usdm-obs-free-thyroid-index)
* hasMember[+] = Reference(usdm-obs-t3-uptake)
* hasMember[+] = Reference(usdm-obs-t4)
* hasMember[+] = Reference(usdm-obs-tsh)

// ObservationDefinition analyte: free_thyroid_index
Instance: usdm-obs-free-thyroid-index
InstanceOf: ObservationDefinition
Usage: #definition
Title: "Free thyroid index"
Description: "Lab-derived analyte observation definition for free_thyroid_index"
* status = #active
* code
  * coding[+]
    * system = "http://loinc.org"
    * code = #32215-6
    * display = "Thyroxine index [Interpretation]"
* permittedDataType = #Quantity
* permittedUnit = UCUM#{index}

